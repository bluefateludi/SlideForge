{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "生成链路观测（obs#8）：SQL 口径与 /api/v1/trace/metrics/summary 一致 —— 时间窗口键为 traces.created_at，spans 一律经 trace_id 关联进窗口；deck 时延只算 finished_at 收口的 trace。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "deck trace 时延（毫秒）：finished_at - started_at，仅统计已收口（finished_at 非空）的 trace，与 /trace/metrics/summary 的 deck_duration_p50/p95 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(traces.created_at, $__interval),\n  percentile_cont(0.50) WITHIN GROUP (ORDER BY (EXTRACT(EPOCH FROM traces.finished_at) - EXTRACT(EPOCH FROM traces.started_at)) * 1000.0) AS p50_ms,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY (EXTRACT(EPOCH FROM traces.finished_at) - EXTRACT(EPOCH FROM traces.started_at)) * 1000.0) AS p95_ms\nFROM traces\nWHERE $__timeFilter(traces.created_at)\n  AND traces.kind = 'deck'\n  AND traces.finished_at IS NOT NULL\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "deck 生成时延 P50/P95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "各 kind 的 trace 成功率（succeeded / total），kind 不写死枚举，出现新 kind 自动多一条序列；与 /trace/metrics/summary 的 trace_success 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, $__interval),\n  kind,\n  ROUND(COUNT(*) FILTER (WHERE status = 'succeeded')::numeric / NULLIF(COUNT(*), 0) * 100, 1) AS success_rate\nFROM traces\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "trace 成功率（按 kind）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "slide 级成功率：task span 且 name LIKE 'slide[%]'，spans 经 trace_id 关联到窗口内 trace；与 /trace/metrics/summary 的 slide_success_rate 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(t.created_at, $__interval),\n  ROUND(COUNT(*) FILTER (WHERE s.status = 'succeeded')::numeric / NULLIF(COUNT(*), 0) * 100, 1) AS success_rate\nFROM spans s\nJOIN traces t ON t.id = s.trace_id\nWHERE $__timeFilter(t.created_at)\n  AND s.span_kind = 'task'\n  AND s.name LIKE 'slide[%]'\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "slide 成功率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "llm span 的 token 日消耗（prompt / completion 分列），按 trace.created_at 归入当天；与 /trace/metrics/summary 的 total_prompt/completion_tokens 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 8,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(t.created_at, '1d'),\n  SUM(s.prompt_tokens) AS prompt_tokens,\n  SUM(s.completion_tokens) AS completion_tokens\nFROM spans s\nJOIN traces t ON t.id = s.trace_id\nWHERE $__timeFilter(t.created_at)\n  AND s.span_kind = 'llm'\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "token 日消耗（llm）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "失败来源占比：status='failed' 的 span 按 error_code 分组，无码归 unknown；与 /trace/metrics/summary 的 failure_breakdown 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "id": 5,
      "options": {
        "displayLabels": ["name", "value", "percent"],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(s.error_code, 'unknown') AS error_code,\n  COUNT(*) AS count\nFROM spans s\nJOIN traces t ON t.id = s.trace_id\nWHERE $__timeFilter(t.created_at)\n  AND s.status = 'failed'\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "title": "失败来源占比（error_code）",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slideforge-postgres"
      },
      "description": "节点（span name）维度的失败率、平均耗时与 llm 平均 completion tokens；与 /trace/metrics/summary 的 node_stats 同口径。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failure_rate_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "failed"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slideforge-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.name AS node,\n  COUNT(*) AS total,\n  COUNT(*) FILTER (WHERE s.status = 'failed') AS failed,\n  ROUND(COUNT(*) FILTER (WHERE s.status = 'failed')::numeric / NULLIF(COUNT(*), 0) * 100, 1) AS failure_rate_pct,\n  ROUND(AVG(s.duration_ms), 1) AS avg_duration_ms,\n  ROUND(AVG(s.completion_tokens) FILTER (WHERE s.span_kind = 'llm'), 1) AS avg_completion_tokens\nFROM spans s\nJOIN traces t ON t.id = s.trace_id\nWHERE $__timeFilter(t.created_at)\nGROUP BY 1\nORDER BY failed DESC, total DESC, 1",
          "refId": "A"
        }
      ],
      "title": "节点失败率与平均耗时",
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
